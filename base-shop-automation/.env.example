# このファイルをコピーして「.env」という名前のファイルを作ってください。
#   cp .env.example .env
#
# .env はGitに記録されない設定です（.gitignoreで除外済み）。
# BASE Developersで発行されたclient_id / client_secretをここに記入します。

# BASE Developersのアプリ管理画面に表示されているクライアントID
BASE_CLIENT_ID=

# BASE Developersのアプリ管理画面に表示されているクライアントシークレット
BASE_CLIENT_SECRET=

# BASE Developersのアプリ設定で登録したコールバックURL
BASE_REDIRECT_URI=https://tkt.base.ec/

# 利用したい権限（スコープ）。カンマ区切り。
# 商品情報の閲覧・更新、注文情報の閲覧・更新に加えて、
# 認証確認用のショップ情報取得（read_users）もリクエストします。
BASE_SCOPE=read_items,write_items,read_orders,write_orders,read_users

# ↓ここから下は auth.py が自動的に書き込みます。自分で入力する必要はありません。
BASE_ACCESS_TOKEN=
BASE_REFRESH_TOKEN=
BASE_TOKEN_EXPIRES_AT=
